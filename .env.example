# Brevo SMTP — envio de emails via SMTP relay (funciona no Railway)
# 1. Cria conta gratuita: https://app.brevo.com (300 emails/dia)
# 2. Vai a SMTP & API → SMTP → gera credenciais SMTP
# 3. Vai a Senders & IP → verifica o teu email como remetente
BREVO_SMTP_USER=<login smtp do brevo>
BREVO_SMTP_PASS=<password smtp do brevo>

# Brevo (Sendinblue) — envio de emails via HTTPS (funciona no Railway)
# Registo gratuito: https://app.brevo.com — 300 emails/dia
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP — Office 365 para envio de emails (fallback local)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=report@socem.pt
# SMTP_PASS=a_sua_password
# SMTP_FROM=report@socem.pt

# LLM / AI Assistant — necessário para o Assistente IA funcionar
# O Assistente IA responde a perguntas sobre o Portal de Estagiários
# Obter API key em: https://forge.manus.im (ou outro provider compatível com OpenAI)
BUILT_IN_FORGE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BUILT_IN_FORGE_API_URL=https://forge.manus.im  # opcional, default: forge.manus.im
